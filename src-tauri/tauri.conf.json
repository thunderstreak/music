{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Player",
  "version": "0.2.5",
  "identifier": "com.thunderstreak.player",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:9080",
    "beforeBuildCommand": "cross-env BUILD_TARGET=web node .electron-vue/build.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Player",
        "width": 1000,
        "height": 563,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#36383b"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Music Player",
    "longDescription": "A music player built with Tauri and Vue",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

